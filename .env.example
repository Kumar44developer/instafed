# =====================================================================
# Instafeed — environment template
# Copy to `.env` and adjust. Every value below is optional; the app
# boots with sane defaults.
# =====================================================================

# ---------- Application -------------------------------------------------
# Secret used to sign session tokens. Auto-generated and persisted to
# `instafeed.secret` when omitted. SET THIS IN PRODUCTION.
# INSTAFEED_SECRET_KEY=change-me-to-a-long-random-string

# Where the SQLite database lives.
# INSTAFEED_DB_PATH=./instafeed.db

# Comma-separated list of allowed CORS origins.
# INSTAFEED_CORS_ORIGINS=http://localhost:8000

# ---------- Instagram credentials ---------------------------------------
# Optional. Supplying them lets Instafeed use a logged-in session, which
# is dramatically more reliable than anonymous access (no HTTP 429s).
# INSTAGRAM_LOGIN=your_instagram_username
# INSTAGRAM_PASSWORD=your_instagram_password

# Minimum delay between two upstream Instagram requests (seconds).
# INSTAGRAM_REQUEST_DELAY=1.5

# ---------- Scheduler ----------------------------------------------------
# Set to 0 to disable the in-process polling thread (e.g. on serverless
# platforms where you trigger /api/poll with an external cron instead).
# INSTAFEED_SCHEDULER=1

# How often the scheduler polls, in minutes.
# POLL_INTERVAL_MINUTES=15

# How many of the latest videos to check per subscription per poll.
# POLL_LATEST_LIMIT=10

# ---------- Demo mode ----------------------------------------------------
# Set to 1 to serve deterministic offline sample data instead of calling
# Instagram. Perfect for product demos, UI work and CI.
# INSTAFEED_DEMO=0

# ---------- Session tuning ------------------------------------------------
# INSTAFEED_TOKEN_TTL_DAYS=30
# INSTAFEED_MIN_PASSWORD_LENGTH=8
# INSTAFEED_PAGE_SIZE=24
# INSTAFEED_MAX_PAGE_SIZE=100
